{
  "id": "kanban-lite",
  "version": "1.0.0",
  "name": "Kanban-lite",
  "description": "A limited, Personal Kanban-style board: cards move from backlog through ready to doing and done. Tags can represent swimlanes. It is not a complete Kanban implementation (no work-in-progress limits, pull signals, blocked markers, classes of service or flow metrics beyond Waypoint's own).",
  "tagLabel": "Swimlane",
  "itemTypes": {
    "card": {
      "label": "Card",
      "executable": true,
      "parents": [],
      "rootAllowed": true
    }
  },
  "statuses": {
    "backlog": { "label": "Backlog", "category": "open" },
    "ready": { "label": "Ready", "category": "open" },
    "doing": { "label": "Doing", "category": "open" },
    "done": { "label": "Done", "category": "done" },
    "cancelled": { "label": "Cancelled", "category": "cancelled" }
  },
  "initialStatuses": ["backlog", "ready", "doing"],
  "transitions": {
    "backlog": ["ready", "doing", "cancelled"],
    "ready": ["backlog", "doing", "cancelled"],
    "doing": ["backlog", "ready", "cancelled"]
  }
}
